{minimum_otp_vsn, "28"}.

{erl_opts, [debug_info]}.

{deps, []}.

{project_plugins, [
    erlfmt,
    rebar3_ex_doc,
    rebar3_hex,
    rebar3_hank,
    {rebar3_mutate, "~> 0.6.1"},
    covertool,
    {rebar3_audit, "~> 0.2"},
    rebar3_sbom
]}.

{mutate, [
    {eunit_tests, #{
        datastar => [
            datastar_chunking_tests,
            datastar_elements_framing_tests,
            datastar_errors_tests,
            datastar_options_tests,
            datastar_property_tests,
            datastar_script_tests,
            datastar_signals_framing_tests,
            datastar_unchanged_output_tests
        ]
    }}
]}.

{cover_enabled, true}.
{cover_export_enabled, true}.
{covertool, [{coverdata_files, ["eunit.coverdata"]}]}.

{erlfmt, [
    write,
    {files, ["src/*.erl", "src/*.app.src", "test/*.erl", "rebar.config"]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{dialyzer, [
    {warnings, [unknown]}
]}.

{ex_doc, [
    {proglang, erlang},
    {main, <<"readme">>},
    {extras, [<<"README.md">>, <<"CHANGELOG.md">>, <<"LICENSE.md">>]},
    {source_url, <<"https://github.com/Taure/datastar">>}
]}.

{hex, [{doc, #{provider => ex_doc}}]}.
